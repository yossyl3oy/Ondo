# Sentry DSNs for error tracking (optional). Both are baked in at build time;
# leave one empty and that side of Ondo never reports anything.
# Get your DSN from https://sentry.io after creating a project

# UI (React). Vite reads it from this file.
VITE_SENTRY_DSN=

# Rust backend, read with option_env! when src-tauri compiles. Cargo doesn't
# read this file: export it in the shell (or CI env) that runs the build.
SENTRY_DSN=
