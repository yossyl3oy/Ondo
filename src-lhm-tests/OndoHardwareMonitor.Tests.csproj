<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local-only tests, not run in CI. Run with: mise exec, then dotnet test src-lhm-tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the LHM-free logic is linked in; the daemon itself needs Windows -->
    <Compile Include="../src-lhm/GpuTemperatureWatchdog.cs" Link="GpuTemperatureWatchdog.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
